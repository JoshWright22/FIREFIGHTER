{
  "name": "firefighter",
  "displayName": "FIREFIGHTER: GPU/CPU/RAM queue for AI agents",
  "description": "FIREFIGHTER lets several AI coding agents share one computer. See in the status bar which agent jobs are running or waiting and how busy your graphics card, processor and memory are. Works in VS Code, Cursor and Windsurf.",
  "version": "0.1.0",
  "publisher": "JoshWright22",
  "license": "MIT",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/JoshWright22/FIREFIGHTER"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other",
    "Machine Learning"
  ],
  "keywords": [
    "gpu",
    "ai agents",
    "claude code",
    "codex",
    "scheduler",
    "vram",
    "mcp"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "firefighter.status",
        "title": "FIREFIGHTER: Show status"
      },
      {
        "command": "firefighter.quote",
        "title": "FIREFIGHTER: Quote a GPU job"
      },
      {
        "command": "firefighter.cancel",
        "title": "FIREFIGHTER: Cancel a job"
      }
    ],
    "configuration": {
      "title": "FIREFIGHTER",
      "properties": {
        "firefighter.path": {
          "type": "string",
          "default": "firefighter",
          "description": "Path to the firefighter binary (machine setting: a workspace can't change which program runs).",
          "scope": "machine"
        }
      }
    }
  },
  "galleryBanner": {
    "color": "#d4147a",
    "theme": "dark"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "restrictedConfigurations": [
        "firefighter.path"
      ],
      "description": "The binary path is only read from your own settings."
    }
  }
}
